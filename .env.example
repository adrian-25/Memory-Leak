# =============================================================================
# MemoryLeak — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values before running docker compose up.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development                   # development | production
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
APP_ALLOWED_ORIGINS=http://localhost:3000

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=memoryleak
POSTGRES_USER=memoryleak_user
POSTGRES_PASSWORD=change-this-password

# Assembled by the application (do not edit this line):
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# On Render, DATABASE_URL is injected from the managed Postgres instance.

# -----------------------------------------------------------------------------
# Neo4j
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64

# -----------------------------------------------------------------------------
# NLP
# -----------------------------------------------------------------------------
SPACY_MODEL=en_core_web_sm            # en_core_web_sm | en_core_web_trf

# -----------------------------------------------------------------------------
# Synthetic Data Generation
# -----------------------------------------------------------------------------
RANDOM_SEED=42

# -----------------------------------------------------------------------------
# LLM (for Phase 10 RAG assistant and Phase 12 LLM Baseline)
# Leave blank if no LLM provider is available.
# -----------------------------------------------------------------------------
LLM_PROVIDER=                         # openai | anthropic | local | (empty)
LLM_API_KEY=                          # Required if LLM_PROVIDER is set
LLM_MODEL=                            # e.g. gpt-4o-mini
LLM_TEMPERATURE=0

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                       # json | text
